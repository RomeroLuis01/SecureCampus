{
  "name": "securecampus",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:ui": "vite",
    "api:dev": "tsx watch backend/src/server.ts",
    "api:build": "tsc -p backend/tsconfig.json",
    "api:start": "node backend/dist/server.js",
    "admin:bootstrap": "tsx scripts/bootstrap-admin.ts",
    "db:seed": "tsx scripts/seed-dev-users.ts",
    "db:up": "docker compose up -d",
    "db:stop": "docker compose stop",
    "db:migrate": "docker compose run --rm migrate up",
    "db:status": "docker compose ps",
    "db:logs": "docker compose logs -f db",
    "test": "vitest run --config vitest.config.unit.ts",
    "test:unit": "vitest run --config vitest.config.unit.ts",
    "test:integration": "vitest run --config vitest.config.integration.ts",
    "test:all": "vitest run",
    "build": "tsc -b && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.2.2",
    "@tanstack/react-query": "^5.67.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.7",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "lucide-react": "^1.16.0",
    "pg": "^8.23.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.13.9",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.15",
    "typescript": "~5.7.3",
    "vite": "^6.2.0",
    "vitest": "^4.1.11"
  }
}
