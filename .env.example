# .env.example — se sube a Git como referencia
# Copia este archivo a .env antes de arrancar:  cp .env.example .env
# Usa contraseñas simples (sin símbolos) en desarrollo para evitar problemas
# con expansión de variables en shell.

POSTGRES_PASSWORD=dev_postgres
APP_DB_PASSWORD=dev_app
LECTURA_DB_PASSWORD=dev_lectura
DB_PORT=5432

# Backend
PORT=4000
NODE_ENV=development
DATABASE_URL=postgres://securecampus_app:dev_app@localhost:5432/securecampus?sslmode=disable
DB_POOL_MAX=10
DB_CONNECTION_TIMEOUT_MS=5000
DB_IDLE_TIMEOUT_MS=30000

# JWT
JWT_SECRET=dev_jwt_secret_change_in_production
JWT_EXPIRES_IN=8h

# CORS
CORS_ORIGIN=http://localhost:5173
